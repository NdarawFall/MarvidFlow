{
  "name": "marvidflow",
  "version": "1.0.0",
  "description": "MarvidFlow 1.0 — Studio de montage & production vidéo automatisé IA",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node 07_Scripts/studio-server.cjs",
    "studio": "node 07_Scripts/studio-server.cjs",
    "home": "node 07_Scripts/studio-server.cjs",
    "render": "node 07_Scripts/render.cjs",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "predist": "node 07_Scripts/audit-build-security.cjs",
    "clean:scratch": "node 07_Scripts/cleanup-scratch.cjs",
    "check:arch": "node 07_Scripts/check-architecture.cjs"
  },
  "keywords": [
    "video-editor",
    "motion-design",
    "ai",
    "gsap",
    "threejs"
  ],
  "author": "NdarawFall",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@xenova/transformers": "^2.17.2",
    "chart.js": "^4.6.1",
    "countup.js": "^2.10.1",
    "electron-updater": "^6.8.11",
    "football-logos": "^0.4.0",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "puppeteer-core": "^25.16.0",
    "srt-parser-2": "^1.2.3",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.marvidflow.studio",
    "productName": "MarvidFlow",
    "copyright": "Copyright © 2026 Ndaraw Fall",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!Clients/**/*",
      "!03_Chaines/**/*",
      "!04_Videos/**/*",
      "!08_Rendus/**/*",
      "!Docs/**/*",
      "!07_Scripts/api_config.json",
      "!07_Scripts/api_config*.json",
      "!api_config.json",
      "!user_settings.json",
      "!.env*",
      "!dist/**/*",
      "!.git/**/*",
      "!.agents/**/*",
      "!scratch/**/*"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/@imgly/**/*",
      "node_modules/@xenova/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "NdarawFall",
        "repo": "MarvidFlow"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "01_Assets/Logos/autoframe_robot_logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarvidFlow Studio",
      "uninstallDisplayName": "MarvidFlow Studio ${version}",
      "artifactName": "MarvidFlow-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NdarawFall/MarvidFlow.git"
  }
}